{
  "name": "@example/portfolio",
  "version": "0.3.0",
  "private": true,
  "module": "true",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "a11y:contrast": "node script/checkContrast.js",
    "images:upload": "node --experimental-strip-types script/upload.mts",
    "publish:scheduled": "node script/publish-scheduled-posts.mjs",
    "test:publish": "node --test script/publish-scheduled-posts.test.mjs",
    "newsletter:draft": "node script/generate-newsletter.mjs",
    "newsletter:kit": "node script/kit-broadcast.mjs",
    "test:newsletter": "node --test script/generate-newsletter.test.mjs",
    "test:newsletter:kit": "node --test script/kit-broadcast.test.mjs",
    "unlighthouse": "pnpm dlx unlighthouse",
    "content:check": "node --experimental-strip-types script/check-content.mjs",
    "test:content": "node --experimental-strip-types --test script/*.test.mjs",
    "images:optimize": "node script/optimize-blog-image.mjs"
  },
  "dependencies": {
    "@astrojs/partytown": "2.1.9",
    "@cloudinary/url-gen": "1.22.0",
    "astro": "7.4.7",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "cloudinary": "2.11.0",
    "dotenv": "18.0.9",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "yaml": "2.9.1"
  }
}
