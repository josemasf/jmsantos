---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Post from "@layouts/Post.astro";
import PostWithImage from "@layouts/PostWithImage.astro";
import SeriesPost from "@layouts/SeriesPost.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const posts = await getCollection("posts");
const seriesPosts = post.data.series
  ? posts
      .filter((entry) => entry.data.series?.slug === post.data.series?.slug)
      .sort((a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0))
  : [];
const formattedDate = new Intl.DateTimeFormat("es-ES", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(post.data.date);
---

{
  post.data.series ? (
    <SeriesPost post={post} seriesPosts={seriesPosts} Content={Content} formattedDate={formattedDate} />
  ) : post.data.image ? (
    <PostWithImage post={post} Content={Content} formattedDate={formattedDate} />
  ) : (
    <Post post={post} Content={Content} formattedDate={formattedDate} />
  )
}
