---
import { getCollection } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";
import { getBlogSeries } from "@data/blog-series";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const seriesSlugs = [...new Set(posts.flatMap((post) => post.data.series?.slug ?? []))];

  return seriesSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const series = slug ? getBlogSeries(slug) : undefined;
const [allPosts, draftPosts] = await Promise.all([getCollection("posts"), getCollection("draftPosts")]);
const posts = allPosts
  .filter((post) => post.data.series?.slug === slug)
  .sort((a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0));
const hasUpcomingPosts = draftPosts.some((post) => post.data.series?.slug === slug);

if (!series) {
  throw new Error(`No se han definido los metadatos de la serie "${slug}".`);
}
---

<MainLayout title={`${series.title} | Series | José María Santos`} description={series.description ?? `Índice de la serie ${series.title}.`}>
  <main id="main-content" class="container mx-auto px-6 py-14 md:px-10 md:py-20">
    <section class="mx-auto max-w-4xl">
      <a href="/blog/" class="inline-flex min-h-11 items-center font-bold text-indigo-700 hover:text-indigo-900 dark:text-indigo-300 dark:hover:text-white"><span class="mr-2" aria-hidden="true">←</span> Volver al blog</a>
      <header class="mt-10 border-b border-slate-200 pb-10 dark:border-slate-800">
        <p class="section-kicker">Serie</p>
        <h1 class="mt-4 font-display text-4xl font-bold leading-tight tracking-tight text-slate-900 dark:text-white md:text-6xl">{series.title}</h1>
        {series.description && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">{series.description}</p>}
        {hasUpcomingPosts && <p class="mt-6 font-bold text-indigo-700 dark:text-cyan-200">Próximamente se publicarán más artículos de esta serie.</p>}
      </header>
      <ol class="mt-10 space-y-4">
        {posts.map((post, index) => (
          <li>
            <a href={`/blog/${post.id}/`} class="group grid gap-3 rounded-lg border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-cyan-400 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-cyan-700 sm:grid-cols-[auto_1fr] sm:gap-5">
              <span class="font-display text-2xl font-bold text-cyan-700 dark:text-cyan-300" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <span><span class="block text-lg font-bold text-slate-900 group-hover:text-indigo-700 dark:text-white dark:group-hover:text-cyan-200">{post.data.title}</span><span class="mt-2 block leading-relaxed text-slate-600 dark:text-slate-300">{post.data.description}</span></span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>
</MainLayout>
