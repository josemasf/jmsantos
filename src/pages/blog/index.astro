---
import { getCollection } from "astro:content";
import BlogListing from "@components/BlogListing.astro";
import MainLayout from "@layouts/MainLayout.astro";

const pageSize = 9;
const allPosts = (await getCollection("posts")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const posts = allPosts.slice(0, pageSize);
const totalPages = Math.ceil(allPosts.length / pageSize);
---

<MainLayout title="Blog | José María Santos" description="Artículos de José María Santos sobre frontend, arquitectura, calidad y producto." ogImage="/images/social/blog.png">
  <BlogListing posts={posts} currentPage={1} totalPages={totalPages} />
</MainLayout>
