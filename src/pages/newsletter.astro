---
import MainLayout from "@layouts/MainLayout.astro";

const scriptSrc = import.meta.env.PUBLIC_KIT_FORM_SCRIPT_SRC?.trim() ?? "";
// El enlace debe copiarse del código JavaScript oficial del formulario Inline de Kit.
// No se admite HTML libre ni scripts de otros dominios en esta integración.
const hasKitForm = /^https:\/\/(?:f\.convertkit\.com\/[a-zA-Z0-9_./?=&%-]+\.js(?:\?[a-zA-Z0-9_=&%-]+)?|[a-zA-Z0-9-]+\.kit\.com\/[a-zA-Z0-9_-]+\/index\.js)$/.test(scriptSrc);
---

<MainLayout title="Newsletter quincenal | José María Santos" description="Una vez cada dos semanas: artículos de frontend, arquitectura, testing e IA, con un avance de las próximas publicaciones.">
  <main id="main-content" class="container mx-auto max-w-4xl px-6 py-16 md:px-10 md:py-24">
    <p class="section-kicker">Newsletter quincenal</p>
    <h1 class="mt-4 font-display text-4xl font-bold tracking-tight md:text-6xl">Ideas y aprendizajes, cada dos semanas.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">Recibe una selección de los últimos artículos del blog, una reflexión breve y un avance de los temas que estoy preparando. Sin ruido ni envíos por cada publicación.</p>
    <div class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900 md:p-10">
      <h2 class="font-display text-2xl font-bold">Apúntate a la newsletter</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">Dos correos al mes aproximadamente. Es gratis, y podrás darte de baja en cualquier momento.</p>
      {hasKitForm ? (
        <div class="mt-6" id="kit-newsletter-form" aria-label="Formulario de suscripción de Kit">
          <script is:inline data-astro-rerun async src={scriptSrc}></script>
        </div>
      ) : (
        <p class="mt-6 rounded-lg bg-amber-50 p-4 text-sm text-amber-950 dark:bg-amber-950/30 dark:text-amber-100" role="status">La suscripción por correo estará disponible próximamente. Mientras tanto, puedes seguir las publicaciones mediante <a class="font-bold underline" href="/rss.xml">RSS</a>.</p>
      )}
      <script async data-uid="5c2c8714b9" src="https://jose-maria-santos.kit.com/5c2c8714b9/index.js"></script>
      <p class="mt-5 text-xs leading-relaxed text-slate-500 dark:text-slate-400">Al suscribirte, Kit gestionará tu dirección de correo y el proceso de confirmación. Consulta la <a href="/privacidad/" class="underline hover:text-cyan-700 dark:hover:text-cyan-200">política de privacidad</a> antes de continuar.</p>
    </div>
    <section class="mt-14" aria-labelledby="newsletter-content">
      <h2 id="newsletter-content" class="font-display text-2xl font-bold">Qué encontrarás</h2>
      <ul class="mt-5 grid gap-4 sm:grid-cols-3">
        <li class="rounded-xl border border-slate-200 p-5 dark:border-slate-800"><strong>Lo publicado</strong><p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Los artículos de las últimas dos semanas, con contexto y enlaces.</p></li>
        <li class="rounded-xl border border-slate-200 p-5 dark:border-slate-800"><strong>Próximamente</strong><p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Un adelanto de los temas previstos, una vez revisados.</p></li>
        <li class="rounded-xl border border-slate-200 p-5 dark:border-slate-800"><strong>Una idea útil</strong><p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Una reflexión o recomendación seleccionada personalmente.</p></li>
      </ul>
    </section>
    <p class="mt-10 text-sm text-slate-600 dark:text-slate-300">¿Prefieres utilizar tu lector de feeds? <a href="/rss.xml" class="font-bold underline hover:text-cyan-700 dark:hover:text-cyan-200">Suscríbete al RSS del blog</a>.</p>
  </main>
</MainLayout>
