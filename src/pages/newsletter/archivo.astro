---
import MainLayout from "@layouts/MainLayout.astro";
import { sentNewsletters } from "../../data/newsletter-archive";

const newsletters = [...sentNewsletters].sort(
  (a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf(),
);

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("es-ES", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(new Date(`${date}T12:00:00`));
---

<MainLayout
  title="Archivo de la newsletter | José María Santos"
  description="Consulta las ediciones enviadas de Lo que aprendo construyendo software."
>
  <main id="main-content" class="container mx-auto max-w-4xl px-6 py-16 md:px-10 md:py-24">
    <a href="/newsletter/" class="theme-link text-sm font-bold underline underline-offset-4">Volver a la newsletter</a>
    <header class="mt-10 max-w-3xl">
      <p class="section-kicker">Ediciones enviadas</p>
      <h1 class="mt-4 font-display text-4xl font-bold tracking-tight md:text-6xl">Archivo de la newsletter</h1>
      <p class="mt-6 text-lg leading-relaxed text-slate-600 dark:text-slate-300">
        Aquí puedes volver a consultar las ediciones que ya han sido enviadas a las personas suscritas.
      </p>
    </header>

    {newsletters.length > 0 ? (
      <ol class="mt-12 space-y-5" aria-label="Newsletters enviadas">
        {newsletters.map((newsletter) => (
          <li class="theme-card rounded-2xl border p-6 md:p-8">
            <time class="text-sm font-semibold text-slate-500 dark:text-slate-400" datetime={newsletter.date}>
              {formatDate(newsletter.date)}
            </time>
            <h2 class="mt-3 font-display text-2xl font-bold tracking-tight md:text-3xl">
              <a class="theme-link underline decoration-transparent underline-offset-4 hover:decoration-current" href={newsletter.url}>
                {newsletter.subject}
              </a>
            </h2>
            <p class="mt-3 max-w-2xl leading-relaxed text-slate-600 dark:text-slate-300">{newsletter.excerpt}</p>
            <a class="theme-link mt-5 inline-flex min-h-11 items-center font-bold underline underline-offset-4" href={newsletter.url}>
              Leer esta edición <span class="sr-only">: {newsletter.subject}</span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <section class="theme-surface mt-12 rounded-2xl border p-7 md:p-10" aria-labelledby="archive-empty-heading">
        <p class="section-kicker">Histórico</p>
        <h2 id="archive-empty-heading" class="mt-3 font-display text-2xl font-bold">Aún no hay ediciones disponibles</h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-slate-600 dark:text-slate-300">
          Cuando haya una edición enviada y publicada para consulta, aparecerá aquí. Los borradores y los envíos programados no se muestran en este archivo.
        </p>
      </section>
    )}

    <p class="mt-10 text-sm text-slate-600 dark:text-slate-300">
      ¿Quieres recibir las próximas ediciones? <a href="/newsletter/" class="theme-link font-bold underline underline-offset-4">Suscríbete a la newsletter</a>.
    </p>
  </main>
</MainLayout>
