---
import type { CollectionEntry } from "astro:content";
import MainLayout from "@layouts/MainLayout.astro";
import RelatedPosts from "@components/RelatedPosts.astro";
import type { BlogTopic } from "@data/blog-topics";
import { articleSchema, breadcrumbSchema } from "@data/blog-seo";

interface Props {
  post: CollectionEntry<"posts">;
  seriesPosts: CollectionEntry<"posts">[];
  Content: any;
  formattedDate: string;
  primaryTopic?: BlogTopic;
  relatedPosts: CollectionEntry<"posts">[];
}

const { post, seriesPosts, Content, formattedDate, primaryTopic, relatedPosts } = Astro.props;
const image = post.data.image;
const series = post.data.series;
const socialImage = series?.image ?? image;
const schemas = [articleSchema(post, socialImage?.src), breadcrumbSchema([{ name: "Inicio", path: "/" }, { name: "Blog", path: "/blog/" }, ...(primaryTopic ? [{ name: primaryTopic.title, path: `/blog/temas/${primaryTopic.slug}/` }] : []), { name: post.data.title, path: `/blog/${post.id}/` }])];
---

<MainLayout title={`${post.data.title} | José María Santos`} description={post.data.description} ogImage={socialImage?.src} ogImageAlt={socialImage?.alt} ogImageWidth={socialImage?.width} ogImageHeight={socialImage?.height} ogType="article" schemas={schemas}>
  <main id="main-content" class="container mx-auto px-6 py-14 md:px-10 md:py-20">
    <article class="mx-auto max-w-6xl">
      <a href="/blog/" class="inline-flex min-h-11 items-center font-bold text-indigo-700 hover:text-indigo-900 dark:text-indigo-300 dark:hover:text-white"><span class="mr-2" aria-hidden="true">←</span> Volver al blog</a>
      <header class="mt-10 grid gap-8 border-b border-slate-200 pb-10 dark:border-slate-800 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end">
        <div>
          {primaryTopic ? <a href={`/blog/temas/${primaryTopic.slug}/`} class="section-kicker hover:underline">{primaryTopic.title}</a> : series && <p class="section-kicker">Serie: {series.title}</p>}
          <h1 class="mt-4 font-display text-4xl font-bold leading-tight tracking-tight text-slate-900 dark:text-white md:text-6xl">{post.data.title}</h1>
          <p class="mt-6 text-lg leading-relaxed text-slate-600 dark:text-slate-300">{post.data.description}</p>
          <p class="mt-6 text-sm font-bold text-slate-500 dark:text-slate-400">Escrito por <a href="/about/" class="underline hover:text-indigo-700 dark:hover:text-cyan-200">José María Santos, Frontend Tech Lead</a></p>
          <time datetime={post.data.date.toISOString()} class="mt-2 block text-sm font-bold text-slate-500 dark:text-slate-400">Publicado el {formattedDate}</time>
          <div class="mt-5 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => <span class="rounded-full bg-cyan-50 px-2.5 py-1 text-xs font-bold text-cyan-800 dark:bg-cyan-950/50 dark:text-cyan-200">{tag}</span>)}
          </div>
        </div>
        {
          series && (
            <aside class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
              <p class="text-xs font-bold uppercase tracking-[.16em] text-cyan-700 dark:text-cyan-300">En esta serie</p>
              {series.description && <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{series.description}</p>}
              <ol class="mt-5 space-y-3">
                {seriesPosts.map((seriesPost) => (
                  <li>
                    <a
                      href={`/blog/${seriesPost.id}/`}
                      aria-current={seriesPost.id === post.id ? "page" : undefined}
                      class:list={[
                        "block rounded-md border px-3 py-2 text-sm font-bold transition",
                        seriesPost.id === post.id
                          ? "border-cyan-300 bg-cyan-50 text-cyan-900 dark:border-cyan-700 dark:bg-cyan-950/40 dark:text-cyan-100"
                          : "border-transparent text-slate-700 hover:border-slate-200 hover:bg-slate-50 dark:text-slate-200 dark:hover:border-slate-700 dark:hover:bg-slate-800",
                      ]}
                    >
                      <span class="mr-2 text-slate-400">{seriesPost.data.series?.order}.</span>{seriesPost.data.title}
                    </a>
                  </li>
                ))}
              </ol>
            </aside>
          )
        }
      </header>
      {
        image && (
          <figure class="mt-10">
            <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="eager" decoding="async" class="w-full rounded-lg border border-slate-200 bg-white shadow-sm dark:border-slate-800" />
            {image.caption && <figcaption class="mx-auto mt-3 max-w-3xl text-center text-sm text-slate-500 dark:text-slate-400">{image.caption}</figcaption>}
          </figure>
        )
      }
      <div class="prose prose-slate mx-auto mt-10 max-w-3xl prose-headings:font-display prose-headings:font-bold prose-a:text-indigo-700 hover:prose-a:text-indigo-900 dark:prose-invert dark:prose-a:text-cyan-300 dark:hover:prose-a:text-cyan-100">
        <Content />
        <RelatedPosts posts={relatedPosts} topicTitle={primaryTopic?.title} />
      </div>
    </article>
  </main>
</MainLayout>
