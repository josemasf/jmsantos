---
// Component Imports
import MainHead from "../components/MainHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CloudflareAnalytics from "../components/CloudflareAnalytics.astro";
import { ClientRouter } from 'astro:transitions';

export interface Props {
  description?: string;
  title?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: string;
  noindex?: boolean;
  schemas?: unknown | unknown[];
}

const {
  description = "El rincón de José María Santos",
  title = "José María Santos: Desarrollador Web",
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  ogType,
  noindex,
  schemas,
} = Astro.props;
---

<html lang="es">
  <head>
    <ClientRouter />
    <MainHead title={title} description={description} ogImage={ogImage} ogImageAlt={ogImageAlt} ogImageWidth={ogImageWidth} ogImageHeight={ogImageHeight} ogType={ogType} noindex={noindex} schemas={schemas} />
    <CloudflareAnalytics />
  </head>
  <body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
