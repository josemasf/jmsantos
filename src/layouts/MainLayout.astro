---
// Component Imports
import MainHead from "../components/MainHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from 'astro:transitions';

export interface Props {
  description?: string;
  title?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  schemas?: unknown | unknown[];
}

const {
  description = "El rincón de José María Santos",
  title = "José María Santos: Desarrollador Web",
  ogImage,
  ogType,
  noindex,
  schemas,
} = Astro.props;
---

<html lang="es">
  <head>
    <ClientRouter />
    <MainHead title={title} description={description} ogImage={ogImage} ogType={ogType} noindex={noindex} schemas={schemas} />
    <!-- Pixel Code for https://overtracking.com/ -->
    <script is:inline defer src="https://cdn.overtracking.com/t/tCElhnUuwll9eKe9c/"></script>
    <!-- END Pixel Code -->
  </head>
  <body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
