---
import SocialLinks from "./SocialLinks.astro";

const currentYear = new Date().getFullYear();
const exploreLinks = [
  { href: "/porfolio/", label: "Portfolio" },
  { href: "/presentations/", label: "Ponencias" },
  { href: "/about/", label: "Sobre mí" },
];
---

<footer class="site-footer">
  <div class="site-footer__glow" aria-hidden="true"></div>
  <div class="site-footer__inner">
    <div class="site-footer__main">
      <a href="/" class="site-footer__brand" aria-label="José María Santos, inicio">
        JoséMa<br /><span>Santos</span>
      </a>
      <p class="site-footer__intro">
        Interfaces claras, arquitectura sólida y productos que avanzan.
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Navegación del pie de página">
      <p class="site-footer__label">Explorar</p>
      <ul>
        {exploreLinks.map((link) => (
          <li><a href={link.href}>{link.label}<span aria-hidden="true">↗</span></a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__connect">
      <p class="site-footer__label">Encuéntrame en</p>
      <SocialLinks />
    </div>
  </div>

  <div class="site-footer__legal">
    <p>© {currentYear} José María Santos</p>
    <a href="https://astro.build" target="_blank" rel="noopener noreferrer">
      Hecho con Astro <span aria-hidden="true">✦</span>
    </a>
    <a class="site-footer__top" href="#main-content">Volver arriba <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style is:global>
  .site-footer {
    position: relative;
    overflow: hidden;
    margin-top: 5rem;
    border-top: 1px solid rgb(14 116 144 / 0.18);
    background: #eaf8fb;
    color: #17213a;
  }

  .dark .site-footer {
    border-color: rgb(103 232 249 / 0.16);
    background: #020617;
    color: #e2e8f0;
  }

  .site-footer__glow {
    position: absolute;
    top: -9rem;
    right: -6rem;
    width: 25rem;
    height: 25rem;
    border-radius: 999px;
    background: rgb(34 211 238 / 0.18);
    filter: blur(70px);
    pointer-events: none;
  }

  .site-footer__inner,
  .site-footer__legal {
    position: relative;
    width: min(100% - 3rem, 76rem);
    margin-inline: auto;
  }

  .site-footer__inner {
    display: grid;
    gap: 3rem;
    padding-block: 4.5rem 3rem;
  }

  .site-footer__brand {
    display: inline-block;
    width: fit-content;
    color: inherit;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: .76;
    letter-spacing: -.08em;
    text-decoration: none;
  }

  .site-footer__brand span { color: #0e7490; }
  .dark .site-footer__brand span { color: #67e8f9; }

  .site-footer__intro {
    max-width: 21rem;
    margin-top: 1.5rem;
    color: #475569;
    font-size: 1rem;
    line-height: 1.55;
  }
  .dark .site-footer__intro { color: #94a3b8; }

  .site-footer__label {
    margin-bottom: 1rem;
    color: #0e7490;
    font-size: .7rem;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .dark .site-footer__label { color: #67e8f9; }

  .site-footer__nav ul { display: grid; gap: .7rem; }
  .site-footer__nav a {
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }
  .site-footer__nav a span {
    display: inline-block;
    margin-left: .35rem;
    color: #0891b2;
    transition: transform .2s ease;
  }
  .site-footer__nav a:hover span { transform: translate(2px, -2px); }

  .site-footer__connect .socials {
    justify-content: flex-start;
    margin-right: 0;
  }
  .site-footer__connect .social {
    border: 1px solid rgb(14 116 144 / .16);
    background: rgb(255 255 255 / .55);
  }
  .dark .site-footer__connect .social {
    border-color: rgb(148 163 184 / .18);
    background: rgb(15 23 42 / .62);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: .9rem 1.5rem;
    align-items: center;
    padding-block: 1.35rem;
    border-top: 1px solid rgb(14 116 144 / .16);
    color: #64748b;
    font-size: .8rem;
  }
  .dark .site-footer__legal { border-color: rgb(148 163 184 / .15); color: #94a3b8; }
  .site-footer__legal a { color: inherit; text-decoration: none; }
  .site-footer__legal a:hover { color: #0e7490; }
  .dark .site-footer__legal a:hover { color: #a5f3fc; }
  .site-footer__legal a span { color: #0891b2; }
  .site-footer__top { margin-left: auto; font-weight: 700; }

  @media (min-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1.7fr) minmax(8rem, .7fr) minmax(10rem, .8fr);
      align-items: start;
      padding-block: 5.25rem 3.75rem;
    }
  }

  @media (max-width: 35rem) {
    .site-footer__inner, .site-footer__legal { width: min(100% - 2.5rem, 76rem); }
    .site-footer__top { width: 100%; margin-left: 0; }
  }
</style>
