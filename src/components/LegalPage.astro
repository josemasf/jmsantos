---
import MainLayout from "../layouts/MainLayout.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<MainLayout title={title} description={description}>
  <main id="main-content" class="legal-page">
    <article>
      <p class="section-kicker">Información legal</p>
      <h1>{title}</h1>
      <slot />
    </article>
  </main>
</MainLayout>

<style>
  .legal-page {
    width: min(100% - 3rem, 52rem);
    margin-inline: auto;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .legal-page article {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .legal-page h1 {
    margin: .6rem 0 2rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 7vw, 4rem);
    font-weight: 700;
    letter-spacing: -.055em;
    line-height: 1;
  }

  .legal-page :global(h2) {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .legal-page :global(p), .legal-page :global(ul) { margin-top: 1rem; }
  .legal-page :global(ul) { padding-left: 1.25rem; list-style: disc; }
  .legal-page :global(a) { color: var(--text-accent); font-weight: 700; }

  @media (max-width: 35rem) {
    .legal-page { width: min(100% - 2.5rem, 52rem); }
  }
</style>
