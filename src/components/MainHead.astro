---
import "../styles/global.css";
const {
  title = "José María Santos: Desarrollador Web",
  description = "El rincón de José María Santos",
  ogImage,
  ogType = "website",
  noindex = false,
  schemas = [],
} = Astro.props;
const site = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, site).toString();
const socialImage = new URL(ogImage ?? "/images/social/blog-default.png", site).toString();
const structuredData = Array.isArray(schemas) ? schemas : [schemas];
---

<meta charset="UTF-8" />
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="José María Santos" />
<meta property="og:locale" content="es_ES" />
<meta property="og:image" content={socialImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
{structuredData.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=Montserrat+Alternates:wght@700&display=swap" rel="stylesheet" />

<script is:inline>
  // It's best to inline this in `head` to avoid FOUC (flash of unstyled content) when changing pages or themes
  if (
    localStorage.getItem("theme") === "dark" ||
    (!("theme" in localStorage) &&
      window.matchMedia("(prefers-color-scheme: dark)").matches)
  ) {
    document.documentElement.classList.add("dark");
  } else {
    document.documentElement.classList.remove("dark");
  }
</script>
