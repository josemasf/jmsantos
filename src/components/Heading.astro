---
const { bgImage } = Astro.props;
---

<div
  class="h-40 md:h-60 overflow-hidden relative bg-no-repeat bg-bottom bg-fixed bg-cover"
  style=`background-image: url('${bgImage}')`
>
  <div
    class="h-full bg-slate-950/65 pl-5 text-white flex flex-col justify-center"
  >
    <h1 class="font-extrabold md:text-md text-[2em]"><slot name="title" /></h1>
  </div>
  <slot name="content" />
</div>
