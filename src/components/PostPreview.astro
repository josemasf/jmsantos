---
import type { CollectionEntry } from "astro:content";
import { getPrimaryPostTopic } from "@data/blog-topics";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const formattedDate = new Intl.DateTimeFormat("es-ES", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(post.data.date);
const tags = post.data.tags.slice(0, 4);
const primaryTopic = getPrimaryPostTopic(post);
const isDraft = import.meta.env.DEV && /(^|\/)drafts\/posts\//.test(post.filePath ?? "");
---

<article
  class:list={[
    "group relative flex h-full flex-col rounded-2xl border p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl",
    isDraft
      ? "border-orange-300 bg-orange-100 hover:bg-orange-200 hover:shadow-orange-950/10 dark:border-orange-700 dark:bg-orange-950/50 dark:hover:bg-orange-950/70"
      : "border-slate-200 bg-white hover:shadow-indigo-950/10 dark:border-slate-700 dark:bg-slate-900",
  ]}
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-bold uppercase tracking-[0.14em]">
    {isDraft && <span class="rounded-full bg-orange-600 px-2 py-1 text-[0.65rem] tracking-[0.12em] text-white dark:bg-orange-500">Borrador</span>}
    {primaryTopic ? <a href={`/blog/temas/${primaryTopic.slug}/`} class="text-cyan-700 hover:underline dark:text-cyan-300">{primaryTopic.title}</a> : <span class="text-cyan-700 dark:text-cyan-300">{post.data.category}</span>}
    <span class="text-slate-400 dark:text-slate-500" aria-hidden="true">•</span>
    <time datetime={post.data.date.toISOString()} class="normal-case tracking-normal text-slate-500 dark:text-slate-400">{formattedDate}</time>
  </div>
  <h2 class="mt-4 font-display text-2xl font-bold leading-tight text-slate-900 dark:text-white">
    <a href={`/blog/${post.id}/`} class="outline-none before:absolute before:inset-0">{post.data.title}</a>
  </h2>
  <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{post.data.description}</p>
  <div class="mt-6 flex flex-wrap gap-2">
    {tags.map((tag) => <span class="rounded-full bg-cyan-50 px-2.5 py-1 text-xs font-bold text-cyan-800 dark:bg-cyan-950/50 dark:text-cyan-200">{tag}</span>)}
  </div>
  <span class="mt-6 inline-flex items-center gap-2 text-sm font-extrabold text-indigo-700 transition group-hover:gap-3 dark:text-indigo-300">Leer artículo <span aria-hidden="true">→</span></span>
</article>
