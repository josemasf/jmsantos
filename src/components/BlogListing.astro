---
import type { CollectionEntry } from "astro:content";
import BlogPagination from "@components/BlogPagination.astro";
import NewsletterCTA from "@components/NewsletterCTA.astro";
import PostPreview from "@components/PostPreview.astro";
import { cloudinaryAssetUrl, cloudinarySrcSet, cloudinaryWidths } from "../utils/cloudinary";

interface Props {
  posts: CollectionEntry<"posts">[];
  currentPage: number;
  totalPages: number;
  categories: string[];
  searchIndex: Array<{ id: string; title: string; description: string; category: string; tags: string[] }>;
}

const { posts, currentPage, totalPages, categories, searchIndex } = Astro.props;
const searchIndexJson = JSON.stringify(searchIndex).replace(/</g, "\\u003c");
const heroImage = "/assets/jose-maria-santos-01.png";
const heroImageSrc = cloudinaryAssetUrl(heroImage, { width: 960, height: 640, crop: "fit" });
const heroImageSrcSet = cloudinarySrcSet(heroImage, cloudinaryWidths.hero, { height: 640, crop: "fit" });
---

<main id="main-content">
  <section class="blog-hero relative isolate overflow-hidden border-b border-slate-200 bg-slate-950 text-white dark:border-slate-800">
    <div class="absolute -left-24 top-0 -z-10 h-72 w-72 rounded-full bg-cyan-400/20 blur-3xl"></div>
    <div class="absolute -right-20 bottom-0 -z-10 h-80 w-80 rounded-full bg-indigo-500/30 blur-3xl"></div>
    <div class="blog-hero__inner">
      <div class="blog-hero__content">
        <p class="blog-hero__eyebrow section-kicker text-cyan-200">Ideas y aprendizajes</p>
        <h1 class="blog-hero__title font-display font-bold">Blog</h1>
        <p class="blog-hero__description text-slate-200">Experiencias y aprendizajes construyendo software: decisiones de ingeniería, arquitectura, calidad, producto y trabajo en equipo.</p>
      </div>
      <div class="blog-hero__media">
        <img class="blog-hero__image" src={heroImageSrc} srcset={heroImageSrcSet} sizes="(min-width: 1100px) 48vw, (min-width: 769px) 42vw, 100vw" alt="Ilustración de José María Santos trabajando con un portátil" width="1536" height="1024" loading="eager" fetchpriority="high" decoding="async" onerror={`this.removeAttribute('srcset'); this.src='${heroImage}'`} />
      </div>
    </div>
  </section>
  <section class="container mx-auto px-6 py-16 md:px-10 md:py-24" aria-label={`Artículos del blog, página ${currentPage}`}>
    <div class="blog-tools mb-8 rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
      <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_16rem]">
        <div>
          <label for="blog-search" class="mb-2 block text-sm font-bold text-slate-800 dark:text-slate-100">Buscar artículos</label>
          <input id="blog-search" type="search" placeholder="Título, tema o tecnología…" autocomplete="off" class="blog-search w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 placeholder:text-slate-500 focus:border-indigo-600 dark:border-slate-700 dark:bg-slate-950 dark:text-white dark:placeholder:text-slate-400" aria-describedby="blog-search-help" />
          <p id="blog-search-help" class="mt-2 text-sm text-slate-600 dark:text-slate-300">Busca en todos los artículos, también en los que están en otras páginas.</p>
        </div>
        <div>
          <label for="blog-category" class="mb-2 block text-sm font-bold text-slate-800 dark:text-slate-100">Filtrar por categoría</label>
          <select id="blog-category" class="blog-category w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-900 focus:border-indigo-600 dark:border-slate-700 dark:bg-slate-950 dark:text-white">
            <option value="">Todas las categorías</option>
            {categories.map((category) => <option value={category}>{category}</option>)}
          </select>
        </div>
      </div>
      <div class="blog-search-results mt-5" hidden>
        <p class="blog-search-count text-sm font-bold text-slate-700 dark:text-slate-200" role="status" aria-live="polite"></p>
        <ul class="blog-search-list mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></ul>
        <button type="button" class="blog-search-more mt-4 min-h-11 rounded-lg border border-slate-300 px-4 py-2 font-bold text-indigo-800 hover:bg-indigo-50 dark:border-slate-700 dark:text-indigo-200 dark:hover:bg-slate-800" hidden>Mostrar más resultados</button>
      </div>
    </div>
    <script type="application/json" id="blog-search-index" set:html={searchIndexJson}></script>
    <div class="blog-post-grid grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {posts.map((post) => <PostPreview post={post} />)}
    </div>
    <BlogPagination currentPage={currentPage} totalPages={totalPages} />
    <NewsletterCTA />
  </section>
</main>

<script>
  type SearchPost = { id: string; title: string; description: string; category: string; tags: string[] };
  const setupBlogSearch = () => {
    const root = document.querySelector<HTMLElement>(".blog-tools");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";
    const indexElement = document.querySelector<HTMLScriptElement>("#blog-search-index");
    const posts = JSON.parse(indexElement?.textContent ?? "[]") as SearchPost[];
    const input = root.querySelector<HTMLInputElement>("#blog-search");
    const category = root.querySelector<HTMLSelectElement>("#blog-category");
    const results = root.querySelector<HTMLElement>(".blog-search-results");
    const list = root.querySelector<HTMLUListElement>(".blog-search-list");
    const count = root.querySelector<HTMLElement>(".blog-search-count");
    const more = root.querySelector<HTMLButtonElement>(".blog-search-more");
    const cards = document.querySelector<HTMLElement>(".blog-post-grid");
    const pagination = document.querySelector<HTMLElement>("[data-blog-pagination]");
    let matching: SearchPost[] = [];
    let shown = 0;

    const render = () => {
      const query = input?.value.trim().toLocaleLowerCase("es") ?? "";
      const selectedCategory = category?.value ?? "";
      const active = query.length > 0 || selectedCategory.length > 0;
      if (!results || !list || !count || !cards) return;
      results.hidden = !active;
      cards.hidden = active;
      if (pagination) pagination.hidden = active;
      if (!active) return;
      matching = posts.filter((post) => {
        const matchesCategory = !selectedCategory || post.category === selectedCategory;
        const searchable = [post.title, post.description, post.category, ...post.tags].join(" ").toLocaleLowerCase("es");
        return matchesCategory && (!query || searchable.includes(query));
      });
      shown = 9;
      paintResults();
    };

    const paintResults = () => {
      if (!list || !count || !more) return;
      count.textContent = matching.length === 1 ? "1 artículo encontrado" : `${matching.length} artículos encontrados`;
      list.replaceChildren(...matching.slice(0, shown).map((post) => {
        const item = document.createElement("li");
        item.className = "rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-950";
        const label = document.createElement("span");
        label.className = "text-xs font-bold uppercase tracking-wider text-cyan-800 dark:text-cyan-300";
        label.textContent = post.category;
        const link = document.createElement("a");
        link.className = "mt-2 block font-display text-lg font-bold leading-snug text-slate-900 hover:text-indigo-700 dark:text-white dark:hover:text-indigo-300";
        link.href = `/blog/${encodeURIComponent(post.id)}/`;
        link.textContent = post.title;
        const description = document.createElement("p");
        description.className = "mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300";
        description.textContent = post.description;
        item.append(label, link, description);
        return item;
      }));
      more.hidden = shown >= matching.length;
    };

    input?.addEventListener("input", render);
    category?.addEventListener("change", render);
    more?.addEventListener("click", () => { shown += 9; paintResults(); });
  };
  document.addEventListener("astro:page-load", setupBlogSearch);
  setupBlogSearch();
</script>

<style>
  .blog-search-results[hidden],
  .blog-post-grid[hidden],
  [data-blog-pagination][hidden] { display: none !important; }
  .blog-hero__inner { display: grid; grid-template-columns: minmax(0, .9fr) minmax(420px, 1.1fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); width: min(calc(100% - 3rem), 1440px); margin-inline: auto; padding-block: clamp(3rem, 5vw, 4.5rem); }
  .blog-hero__content { max-width: 44rem; }
  .blog-hero__eyebrow { margin-bottom: 1.25rem; }
  .blog-hero__title { margin: 0; font-size: clamp(3.5rem, 7vw, 6rem); line-height: .95; letter-spacing: -.04em; }
  .blog-hero__description { max-width: 43rem; margin-top: 2rem; font-size: clamp(1.125rem, 2vw, 1.5rem); line-height: 1.55; }
  .blog-hero__media { position: relative; display: flex; align-items: flex-end; justify-content: center; min-width: 0; }
  .blog-hero__media::before { position: absolute; inset: 15% 10% 5%; z-index: 0; border-radius: 50%; background: radial-gradient(circle, rgb(50 210 220 / 12%), transparent 68%); content: ""; pointer-events: none; }
  .blog-hero__image { position: relative; z-index: 1; display: block; width: min(100%, 47.5rem); height: auto; max-height: 27.5rem; object-fit: contain; }
  @media (max-width: 1100px) { .blog-hero__inner { grid-template-columns: minmax(0, 1fr) minmax(340px, .9fr); gap: 2rem; } .blog-hero__image { max-height: 26.875rem; } }
  @media (max-width: 768px) { .blog-hero__inner { grid-template-columns: 1fr; gap: 2rem; width: min(calc(100% - 2rem), 42.5rem); padding-block: 3rem 2rem; } .blog-hero__content { max-width: none; } .blog-hero__media { justify-content: center; } .blog-hero__image { width: min(100%, 32.5rem); max-height: 22.5rem; } }
  @media (max-width: 420px) { .blog-hero__title { font-size: clamp(3rem, 16vw, 3.5rem); } .blog-hero__image { max-height: 17.5rem; } }
</style>
