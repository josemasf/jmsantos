---
const dialogId = "visual-profile-dialog";
---

<section class="about-visual" aria-labelledby="visual-profile-heading">
  <div class="about-section-intro">
    <p class="section-kicker">Perfil visual</p>
    <h2 id="visual-profile-heading">Mi forma de entender el liderazgo técnico</h2>
    <p>Una visión complementaria de mi rol, las personas con las que trabajo, los principios que aplico y el impacto que busco generar.</p>
  </div>
  <button class="visual-profile-trigger" type="button" aria-haspopup="dialog" aria-controls={dialogId} data-visual-profile-open>
    <picture>
      <source srcset="/images/about/josema-santos-tl.avif" type="image/avif" />
      <source srcset="/images/about/josema-santos-tl.webp" type="image/webp" />
      <img src="/images/about/josema-santos-tl.png" alt="Ilustración del perfil profesional de José María Santos como líder técnico frontend" width="1536" height="1024" loading="lazy" decoding="async" />
    </picture>
    <span>Ver perfil visual completo <span aria-hidden="true">↗</span></span>
  </button>
</section>

<dialog id={dialogId} class="visual-profile-dialog" aria-labelledby="visual-profile-dialog-title" data-visual-profile-dialog>
  <div class="visual-profile-dialog__frame">
    <div class="visual-profile-dialog__bar">
      <p id="visual-profile-dialog-title">Perfil visual de José María Santos</p>
      <button type="button" class="visual-profile-dialog__close" aria-label="Cerrar perfil visual" data-visual-profile-close>×</button>
    </div>
    <div class="visual-profile-dialog__content">
      <picture>
        <source srcset="/images/about/josema-santos-tl.avif" type="image/avif" />
        <source srcset="/images/about/josema-santos-tl.webp" type="image/webp" />
        <img src="/images/about/josema-santos-tl.png" alt="Ilustración del perfil profesional de José María Santos como líder técnico frontend, con propósito, responsabilidades, tecnologías, valores, equipos e intereses personales" width="1536" height="1024" decoding="async" />
      </picture>
    </div>
  </div>
</dialog>

<script is:inline>
  let lastTrigger;
  function bindVisualProfile() {
    const dialog = document.querySelector("[data-visual-profile-dialog]");
    const trigger = document.querySelector("[data-visual-profile-open]");
    const closeButton = document.querySelector("[data-visual-profile-close]");
    if (!dialog || !trigger || trigger.dataset.bound) return;
    trigger.dataset.bound = "true";
    trigger.addEventListener("click", () => { lastTrigger = trigger; dialog.showModal(); });
    closeButton.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener("close", () => lastTrigger?.focus());
  }
  document.addEventListener("astro:page-load", bindVisualProfile);
  bindVisualProfile();
</script>

<style>
  .about-visual { border-top: 1px solid rgb(14 116 144 / .18); }
  .about-section-intro { max-width: 43rem; }
  .about-section-intro h2 { margin: .55rem 0 1rem; font-family: var(--font-display); color: var(--text-primary); font-size: clamp(2.2rem, 4vw, 3.6rem); letter-spacing: -.065em; line-height: .98; }
  .about-section-intro > p:last-child { color: var(--text-secondary); font-size: 1.08rem; line-height: 1.7; }
  .visual-profile-trigger { display: grid; width: 100%; gap: 1rem; margin-top: 2.5rem; border: 0; padding: 0; background: transparent; color: var(--text-primary); cursor: zoom-in; text-align: left; }
  .visual-profile-trigger picture { display: block; overflow: hidden; border: 1px solid rgb(14 116 144 / .28); background: #eaf8fb; box-shadow: 0 1.5rem 3rem rgb(15 23 42 / .12); }
  .visual-profile-trigger img { display: block; width: 100%; height: auto; transition: transform .3s ease; }
  .visual-profile-trigger:hover img { transform: scale(1.015); }
  .visual-profile-trigger > span { display: inline-flex; width: fit-content; min-height: 2.75rem; align-items: center; gap: .5rem; border-bottom: 2px solid var(--text-accent); font-weight: 900; }
  .visual-profile-dialog { width: min(100% - 1.5rem, 96rem); max-width: none; max-height: calc(100dvh - 1.5rem); border: 0; padding: 0; background: #020617; color: white; box-shadow: 0 1.5rem 5rem rgb(2 6 23 / .55); }
  .visual-profile-dialog::backdrop { background: rgb(2 6 23 / .82); }
  .visual-profile-dialog__frame { display: grid; max-height: calc(100dvh - 1.5rem); grid-template-rows: auto minmax(0, 1fr); }
  .visual-profile-dialog__bar { display: flex; min-height: 3.75rem; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; border-bottom: 1px solid rgb(165 243 252 / .25); }
  .visual-profile-dialog__bar p { margin: 0; font-size: .9rem; font-weight: 800; }
  .visual-profile-dialog__close { display: inline-grid; width: 2.75rem; height: 2.75rem; flex: 0 0 auto; place-items: center; border: 1px solid rgb(165 243 252 / .45); background: transparent; color: white; cursor: pointer; font-size: 2rem; line-height: 1; }
  .visual-profile-dialog__content { overflow: auto; padding: 1rem; overscroll-behavior: contain; }
  .visual-profile-dialog__content img { display: block; width: max(46rem, 100%); height: auto; margin-inline: auto; }
  @media (max-width: 44.99rem) { .visual-profile-trigger picture { max-height: 13rem; } .visual-profile-trigger img { min-width: 29rem; max-width: none; transform: translateX(-.5rem); } .visual-profile-trigger:hover img { transform: translateX(-.5rem); } }
  @media (prefers-reduced-motion: reduce) { .visual-profile-trigger img { transition: none; } }
</style>
