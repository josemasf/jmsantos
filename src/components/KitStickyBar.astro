---
// The optional Kit sticky bar is only configured on blog routes. Its external
// script is inserted by analytics-consent.ts once a privacy choice is made.
import { isBlogRoute, resolveKitScript } from "../utils/kit-embed";

const isBlogPage = isBlogRoute(Astro.url.pathname);
const { src: scriptSrc, isValid: hasValidKitScript, uid: kitFormUid } = resolveKitScript(import.meta.env.PUBLIC_KIT_STICKY_FORM_SCRIPT_SRC);
---

{isBlogPage && hasValidKitScript && (
  <div hidden data-kit-sticky-config data-script-src={scriptSrc} data-uid={kitFormUid}></div>
)}

<style is:global>
  .formkit-sticky-bar {
    z-index: 999999 !important;
  }
</style>
