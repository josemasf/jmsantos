---
// Cargar la barra solo en el blog, no en newsletter ni portfolio.
import { isBlogRoute, resolveKitScript } from "../utils/kit-embed";

const isBlogPage = isBlogRoute(Astro.url.pathname);
const { src: scriptSrc, isValid: hasValidKitScript, uid: kitFormUid } = resolveKitScript(import.meta.env.PUBLIC_KIT_STICKY_FORM_SCRIPT_SRC);
---

{isBlogPage && hasValidKitScript && (
  <script is:inline data-astro-rerun async data-uid={kitFormUid} src={scriptSrc} data-kit-sticky-bar></script>
)}
