<button
  type="button"
  class="theme-button inline-flex h-11 w-11 items-center justify-center rounded-lg text-slate-800 transition-colors hover:bg-slate-200 dark:text-white dark:hover:bg-slate-700"
  aria-label="Activar modo oscuro"
  aria-pressed="false"
  title="Cambiar tema"
>
  <svg data-theme-icon="sun" aria-hidden="true" class="h-6 w-6 fill-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
  </svg>
  <svg data-theme-icon="moon" aria-hidden="true" class="hidden h-6 w-6 fill-current" viewBox="0 0 20 20">
    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
  </svg>
</button>

<script is:inline>
  window.updateThemeControl = function () {
    const isDark = document.documentElement.classList.contains("dark");
    const button = document.querySelector(".theme-button");
    if (!button) return;

    button.setAttribute("aria-pressed", String(isDark));
    button.setAttribute("aria-label", isDark ? "Activar modo claro" : "Activar modo oscuro");
    button.querySelector('[data-theme-icon="sun"]')?.classList.toggle("hidden", !isDark);
    button.querySelector('[data-theme-icon="moon"]')?.classList.toggle("hidden", isDark);
  };

  window.initTheme = function () {
    const theme = localStorage.getItem("theme") || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    document.documentElement.classList.toggle("dark", theme === "dark");
    window.updateThemeControl();
  };

  document.addEventListener("click", (event) => {
    const button = event.target.closest(".theme-button");
    if (!button) return;
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    window.updateThemeControl();
  });

  window.initTheme();
  document.addEventListener("astro:after-swap", window.initTheme);
</script>
