---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <aside class="mt-14 border-t border-slate-200 pt-8 dark:border-slate-800" aria-labelledby="related-posts-heading">
    <p class="section-kicker">Para seguir</p>
    <h2 id="related-posts-heading" class="mt-2 font-display text-2xl font-bold text-slate-900 dark:text-white">Contenido relacionado</h2>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="block rounded-lg border border-slate-200 bg-white p-4 font-bold text-indigo-800 transition hover:border-cyan-400 hover:bg-cyan-50 dark:border-slate-700 dark:bg-slate-900 dark:text-cyan-200 dark:hover:bg-slate-800">
            {post.data.title}<span class="ml-2" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}
