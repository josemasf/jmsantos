---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"posts">[];
  topicTitle?: string;
}

const { posts, topicTitle } = Astro.props;
---

{posts.length > 0 && (
  <aside class="not-prose mt-14 border-t border-slate-200 pt-8 dark:border-slate-800" aria-labelledby="related-posts-heading">
    <p class="section-kicker">Sigue explorando</p>
    <h2 id="related-posts-heading" class="mt-2 font-display text-2xl font-bold text-slate-900 dark:text-white">
      {topicTitle ? `Más artículos sobre ${topicTitle}` : "Más lecturas para ti"}
    </h2>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-300">
      {topicTitle ? `Una selección de artículos del tema ${topicTitle}.` : "Otros artículos que pueden interesarte."}
    </p>
    <ul class="m-0 mt-5 grid list-none gap-3 p-0 sm:grid-cols-2" role="list">
      {posts.map((post, index) => (
        <li
          class:list={[
            "m-0 p-0 before:hidden",
            posts.length % 2 !== 0 && index === posts.length - 1 && "sm:col-span-2",
          ]}
        >
          <a href={`/blog/${post.id}/`} class="group flex min-h-28 items-start justify-between gap-4 rounded-lg border border-slate-200 bg-white p-5 font-bold leading-snug text-indigo-800 no-underline transition duration-200 hover:-translate-y-0.5 hover:border-cyan-400 hover:bg-cyan-50 hover:text-indigo-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-500 dark:border-slate-700 dark:bg-slate-900 dark:text-cyan-200 dark:hover:border-cyan-500 dark:hover:bg-slate-800 dark:hover:text-white">
            <span>{post.data.title}</span>
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full border border-current text-base transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}
