---
import { canUseCloudinary, cloudinaryAssetUrl, cloudinarySrcSet, cloudinaryWidths } from "../utils/cloudinary";

const { frontmatter, url } = Astro.props.presentation;

const image = frontmatter.img;
const useCloudinary = image && canUseCloudinary(image);
const imageSrc = useCloudinary ? cloudinaryAssetUrl(image, { width: 960, height: 600, crop: "fill" }) : image;
const imageSrcSet = useCloudinary ? cloudinarySrcSet(image, cloudinaryWidths.grid, { height: 600, crop: "fill" }) : undefined;
---

<article class="theme-card group h-full overflow-hidden rounded-2xl border transition duration-300 hover:-translate-y-1 focus-within:-translate-y-1">
  <a href={url} class="block h-full">
    {image && <img alt={`Portada de la ponencia ${frontmatter.title}`} src={imageSrc} srcset={imageSrcSet} sizes="(min-width: 1280px) 29vw, (min-width: 768px) 44vw, 100vw" width="960" height="600" class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy" decoding="async" onerror={useCloudinary ? `this.removeAttribute('srcset'); this.src='${image}'` : undefined} />}
    <div class="flex flex-col p-6">
      <p class="section-kicker">Ponencia</p>
      <h2 class="mt-3 font-display text-2xl font-bold leading-tight text-slate-900 dark:text-white">{frontmatter.title}</h2>
      <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{frontmatter.description}</p>
      <span class="mt-6 inline-flex items-center gap-2 text-sm font-extrabold text-indigo-700 transition group-hover:gap-3 dark:text-indigo-300">Ver ponencia <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>
