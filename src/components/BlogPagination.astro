---
interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;
const pageUrl = (page: number) => (page === 1 ? "/blog/" : `/blog/${page}/`);
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);
---

{
  totalPages > 1 && (
    <nav class="mt-12 flex flex-col items-center justify-between gap-5 border-t border-slate-200 pt-8 sm:flex-row dark:border-slate-800" aria-label="Paginación del blog" data-blog-pagination>
      <p class="text-sm font-semibold text-slate-600 dark:text-slate-300">
        Página {currentPage} de {totalPages}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-2">
        {currentPage > 1 && (
          <a href={pageUrl(currentPage - 1)} class="inline-flex min-h-11 items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700 transition hover:border-cyan-500 hover:bg-cyan-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">
            <span aria-hidden="true">←</span><span class="ml-2">Anterior</span>
          </a>
        )}
        <ol class="flex items-center gap-2" aria-label="Páginas">
          {pageNumbers.map((page) => (
            <li>
              {page === currentPage ? (
                <span class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg bg-indigo-700 px-3 py-2 text-sm font-extrabold text-white dark:bg-indigo-500" aria-current="page">
                  <span class="sr-only">Página </span>{page}
                </span>
              ) : (
                <a href={pageUrl(page)} class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-slate-300 px-3 py-2 text-sm font-bold text-slate-700 transition hover:border-cyan-500 hover:bg-cyan-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800" aria-label={`Ir a la página ${page}`}>
                  {page}
                </a>
              )}
            </li>
          ))}
        </ol>
        {currentPage < totalPages && (
          <a href={pageUrl(currentPage + 1)} class="inline-flex min-h-11 items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700 transition hover:border-cyan-500 hover:bg-cyan-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">
            <span class="mr-2">Siguiente</span><span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </nav>
  )
}

<script>
  import type { TransitionBeforePreparationEvent } from "astro:transitions/client";

  let paginationScrollPosition: number | undefined;

  document.addEventListener("astro:before-preparation", (event) => {
    const { sourceElement } = event as TransitionBeforePreparationEvent;

    if (sourceElement?.closest("[data-blog-pagination]")) {
      paginationScrollPosition = window.scrollY;
    }
  });

  document.addEventListener("astro:after-swap", () => {
    if (paginationScrollPosition === undefined) return;

    const scrollPosition = paginationScrollPosition;
    paginationScrollPosition = undefined;
    requestAnimationFrame(() => window.scrollTo({ top: scrollPosition, behavior: "instant" }));
  });
</script>
