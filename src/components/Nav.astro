---
import SocialLinks from "./SocialLinks.astro";
import DarkModeToggle from "./DarkModeToggle.astro";

const pathname = Astro.url.pathname;
const links = [
  { href: "/porfolio/", label: "Portfolio" },
  { href: "/presentations/", label: "Ponencias" },
  { href: "/about/", label: "Sobre mí" },
];
const isActive = (href: string) => pathname === href || (href !== "/" && pathname.startsWith(href));
---

<nav aria-label="Navegación principal" class="border-b border-cyan-950/10 bg-gradient-to-r from-cyan-100 via-sky-50 to-indigo-100 dark:border-white/10 dark:from-cyan-950 dark:via-slate-950 dark:to-indigo-950">
  <div class="container mx-auto flex min-h-18 items-center justify-between gap-4 px-4 py-3 md:px-6">
    <a href="/" class="font-display shrink-0 whitespace-nowrap text-xl font-bold tracking-[-0.06em] text-slate-950 dark:text-white md:text-2xl" aria-label="José María Santos, inicio">
      JoséMa Santos
    </a>

    <div class="hidden items-center gap-7 md:flex">
      <ul class="flex items-center gap-6 font-bold text-slate-700 dark:text-slate-200">
        {links.map((link) => <li><a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={["border-b-2 py-2 transition", isActive(link.href) ? "border-indigo-700 text-indigo-800 dark:border-cyan-300 dark:text-cyan-200" : "border-transparent hover:border-indigo-400 hover:text-indigo-800 dark:hover:text-cyan-200"]}>{link.label}</a></li>)}
      </ul>
      <SocialLinks />
    </div>

    <DarkModeToggle />

    <details class="relative md:hidden">
      <summary class="flex h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-300 bg-white/70 text-sm font-bold text-slate-800 marker:content-none dark:border-slate-700 dark:bg-slate-900/80 dark:text-white">
        <span class="sr-only">Abrir menú</span>
        <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </summary>
      <div class="absolute right-0 top-13 z-40 w-65 rounded-xl border border-slate-200 bg-white p-3 shadow-xl dark:border-slate-700 dark:bg-slate-900">
        <ul class="space-y-1">
          {links.map((link) => <li><a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={["block rounded-lg px-3 py-3 font-bold", isActive(link.href) ? "bg-indigo-50 text-indigo-800 dark:bg-indigo-950 dark:text-cyan-200" : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"]}>{link.label}</a></li>)}
        </ul>
        <div class="mt-3 border-t border-slate-200 pt-3 dark:border-slate-700"><SocialLinks /></div>
      </div>
    </details>
  </div>
</nav>
