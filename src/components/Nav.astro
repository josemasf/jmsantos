---
import SocialLinks from "./SocialLinks.astro";
import DarkModeToggle from "./DarkModeToggle.astro";

const pathname = Astro.url.pathname;
const links = [
  { href: "/porfolio/", label: "Portfolio" },
  { href: "/presentations/", label: "Ponencias" },
  { href: "/blog/", label: "Blog" },
  { href: "/about/", label: "Sobre mí" },
];
const isActive = (href: string) => pathname === href || (href !== "/" && pathname.startsWith(href));
---

<nav aria-label="Navegación principal" class="site-nav">
  <div class="container mx-auto flex min-h-18 items-center justify-between gap-4 px-4 py-3 md:px-6">
    <a href="/" class="font-display shrink-0 whitespace-nowrap text-xl font-bold tracking-[-0.06em] text-slate-950 dark:text-white md:text-2xl">
      JoseMa <span class="site-brand__accent">Santos</span>
    </a>

    <div class="hidden items-center gap-7 md:flex">
      <ul class="site-nav__links flex items-center gap-6 font-bold">
        {links.map((link) => <li><a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={["border-b-2 py-2 transition", isActive(link.href) ? "is-active" : ""]}>{link.label}</a></li>)}
      </ul>
      <SocialLinks />
    </div>

    <DarkModeToggle />

    <details class="relative md:hidden">
      <summary class="site-nav__menu-button flex h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-lg border text-sm font-bold marker:content-none">
        <span class="sr-only">Abrir menú</span>
        <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </summary>
      <div class="site-nav__menu absolute right-0 top-13 z-40 w-65 rounded-xl border p-3 shadow-xl">
        <ul class="space-y-1">
          {links.map((link) => <li><a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class:list={["site-nav__menu-link block rounded-lg px-3 py-3 font-bold", isActive(link.href) ? "is-active" : ""]}>{link.label}</a></li>)}
        </ul>
        <div class="site-nav__menu-social mt-3 border-t pt-3"><SocialLinks /></div>
      </div>
    </details>
  </div>
</nav>

<style>
  .site-nav {
    border-bottom: 1px solid var(--border-subtle);
    background: linear-gradient(105deg, color-mix(in srgb, var(--surface-subtle) 80%, #67e8f9 20%), var(--surface) 52%, color-mix(in srgb, var(--surface-subtle) 82%, #a5b4fc 18%));
    color: var(--text-primary);
  }

  .site-nav__links { color: var(--text-secondary); }
  .site-nav__links a { border-color: transparent; }
  .site-nav__links a:hover,
  .site-nav__links a.is-active { color: var(--text-link); }
  .site-nav__links a.is-active { border-color: var(--text-link); }
  .site-nav__menu-button { border-color: var(--border-strong); background: var(--surface-raised); color: var(--text-primary); }
  .site-nav__menu-button:hover { background: var(--surface-hover); }
  .site-nav__menu { border-color: var(--border-subtle); background: var(--surface-raised); }
  .site-nav__menu-link { color: var(--text-secondary); }
  .site-nav__menu-link:hover { background: var(--surface-hover); color: var(--text-primary); }
  .site-nav__menu-link.is-active { background: color-mix(in srgb, var(--text-link) 12%, var(--surface-raised)); color: var(--text-link); }
  .site-nav__menu-social { border-color: var(--border-subtle); }

  .site-brand__accent {
    color: var(--text-accent);
  }
</style>
