---
import { cloudinaryAssetUrl, cloudinarySrcSet, cloudinaryWidths } from "../utils/cloudinary";

const { frontmatter, url } = Astro.props.presentation;
const tags = (frontmatter.tags ?? []).slice(0, 4);
const canUseCloudinary = frontmatter.img?.startsWith("/assets/") && !frontmatter.img.endsWith(".svg");
const fallbackSrc = frontmatter.img;
const imgSrc = canUseCloudinary ? cloudinaryAssetUrl(frontmatter.img, { width: 960, height: 600, crop: "fill" }) : fallbackSrc;
const imgSrcSet = canUseCloudinary ? cloudinarySrcSet(frontmatter.img, cloudinaryWidths.grid, { height: 600, crop: "fill" }) : undefined;
---

<article class="group h-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-indigo-950/10 dark:border-slate-700 dark:bg-slate-900">
  <a href={url} class="block h-full">
    <img
      alt={`Captura del proyecto ${frontmatter.title}`}
      src={imgSrc}
      srcset={imgSrcSet}
      sizes="(min-width: 1280px) 29vw, (min-width: 768px) 44vw, 100vw"
      class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
      loading="lazy"
      decoding="async"
      onerror={canUseCloudinary ? `this.removeAttribute('srcset'); this.src='${fallbackSrc}'` : undefined}
    />
    <div class="flex h-[calc(100%-1px)] flex-col p-6">
      <div class="mb-4 flex flex-wrap gap-2">
        {tags.map((tag: string) => <span class="rounded-full bg-cyan-50 px-2.5 py-1 text-xs font-bold text-cyan-800 dark:bg-cyan-950/50 dark:text-cyan-200">{tag}</span>)}
      </div>
      <h2 class="font-display text-2xl font-bold leading-tight text-slate-900 dark:text-white">{frontmatter.title}</h2>
      <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{frontmatter.description}</p>
      <span class="mt-6 inline-flex items-center gap-2 text-sm font-extrabold text-indigo-700 transition group-hover:gap-3 dark:text-indigo-300">Ver proyecto <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>
